<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".App"
        android:appCategory="video"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.mpvex"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="35">
        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:exported="true"
            android:theme="@style/Theme.mpvex">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          桌面图标切换用的 activity-alias（外观 → 桌面图标）。

          ⚠️ Android 的桌面图标只能是 APK 内的静态资源，不能从网络下载 ——
            所以「换图标」只有这一条路：为每套图标开一个 alias，运行时用
            PackageManager.setComponentEnabledSetting 启用其中一个、禁用其余。
            见 ui/preferences/AppIconManager.kt。

          ⚠️ 每个 alias 都必须自带一份 MAIN/LAUNCHER filter，缺了就不出现在桌面。
          ⚠️ android:targetActivity 指向 MainActivity，进程与单例行为完全不变，
            所以切换不���「另一个 App」，只是换了个壳。
        -->
        <activity-alias
            android:name=".MainActivityAliasDeepSea"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_deepsea"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_deepsea"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityAliasMidnight"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_midnight"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_midnight"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityAliasMinimal"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_minimal"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_minimal"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityAliasAmber"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_amber"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_amber"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ui.player.PlayerActivity"
            android:screenOrientation="locked"
            android:autoRemoveFromRecents="true"
            android:noHistory="false"
            android:excludeFromRecents="false"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
            android:exported="false"
            android:launchMode="singleTask"
            android:documentLaunchMode="never"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.mpvex" />

        <!--
          「视界流」：仿抖音竖屏上下滑连播的播放器。

          单独一个 Activity：configChanges 里自己接管旋转，横竖屏切换不会重建
          —— 重建会把 MPVLib 的解码实例跟着一起销毁重建，画面要黑一整轮。
        -->
        <activity
            android:name=".ui.player.feed.VerticalFeedActivity"
            android:screenOrientation="sensorLandscape"
            android:autoRemoveFromRecents="true"
            android:noHistory="false"
            android:excludeFromRecents="false"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
            android:exported="false"
            android:launchMode="singleTask"
            android:documentLaunchMode="never"
            android:resizeableActivity="true"
            android:theme="@style/Theme.mpvex.Feed" />

        <activity android:name=".presentation.crash.CrashActivity" android:screenOrientation="portrait" />

        <activity
            android:name=".ui.mediainfo.MediaInfoActivity"
            android:screenOrientation="portrait"
            android:exported="true"
            android:theme="@style/Theme.mpvex"
            android:label="Media Info">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/x-subrip" />
                <data android:mimeType="application/x-subtitle" />
                <data android:mimeType="application/x-subtitle-srt" />
                <data android:mimeType="application/x-subtitle-ssa" />
                <data android:mimeType="application/x-subtitle-ass" />
                <data android:mimeType="application/x-subtitle-vtt" />
                <data android:mimeType="application/ogg" />
                <data android:mimeType="application/x-matroska" />
                <data android:mimeType="application/x-flac" />
                <data android:mimeType="application/mp4" />
                <data android:mimeType="application/vnd.apple.mpegurl" />
                <data android:mimeType="application/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/x-subrip" />
                <data android:mimeType="application/x-subtitle" />
                <data android:mimeType="application/x-matroska" />
                <data android:mimeType="application/x-flac" />
                <data android:mimeType="application/mp4" />
                <data android:mimeType="application/vnd.apple.mpegurl" />
                <data android:mimeType="application/x-mpegurl" />
            </intent-filter>
        </activity>

        <service
            android:name=".ui.player.MediaPlaybackService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

        <receiver
            android:name="androidx.media.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- 桌面小组件：「继续观看」（3 条最近没看完的内容） -->
        <receiver
            android:name=".widget.EmbyContinueWatchingWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/emby_continue_widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

    </application>
</manifest>
