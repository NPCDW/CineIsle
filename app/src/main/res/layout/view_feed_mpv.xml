<?xml version="1.0" encoding="utf-8"?>
<!--
  视界流唯一的 mpv 画面层。VerticalPager 只承载分页触摸；翻页时同一 MPVView 换源。
  根节点不消费触摸，Compose 的翻页、点击、亮度、音量和 seek 手势可正常穿过。
-->
<app.marlboroadvance.mpvex.ui.player.feed.InertTouchFrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/feedMpvRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <app.marlboroadvance.mpvex.ui.player.MPVView
        android:id="@+id/feedMpv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

</app.marlboroadvance.mpvex.ui.player.feed.InertTouchFrameLayout>
